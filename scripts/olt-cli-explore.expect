#!/usr/bin/expect -f
# Exploracion CLI OLT: UNA sola sesion SSH. No ejecutar en paralelo.
set timeout 45
set output_file "/tmp/olt-cli-explore-raw.txt"
set delay_ms 400

set ssh_opts "-o StrictHostKeyChecking=no -o PreferredAuthentications=password -o PubkeyAuthentication=no -o KexAlgorithms=diffie-hellman-group-exchange-sha1 -o HostKeyAlgorithms=ssh-rsa -o PubkeyAcceptedKeyTypes=ssh-rsa -o Ciphers=aes128-cbc -o ConnectionAttempts=1"

proc log_section {title} {
    global output_file
    set msg "\n\n========== $title ==========\n"
    set f [open $output_file a]
    puts -nonewline $f $msg
    close $f
}

proc wait_for_prompt {pattern} {
    expect {
        -re "---- More \( Press 'Q' to break \) ----" {
            send " "
            exp_continue
        }
        -re "More \( Press 'Q' to break \)" {
            send " "
            exp_continue
        }
        -re $pattern {
            return
        }
        timeout {
            return
        }
    }
}

proc recover_prompt {pattern} {
    send "Q\r"
    after 300
    send "\003\r"
    after 300
    wait_for_prompt $pattern
}

proc enter_enable {p_user p_enable} {
    global output_file
    log_section "ENTER enable"
    wait_for_prompt $p_user
    send -- "enable\r"
    expect {
        -re "(?i)password:" {
            send -- "admin\r"
            exp_continue
        }
        -re $p_enable {
            set buf $expect_out(buffer)
        }
        timeout {
            set buf "TIMEOUT waiting enable (expected: $p_enable)\n"
            recover_prompt $p_user
        }
    }
    set f [open $output_file a]
    puts -nonewline $f $buf
    close $f
}

proc send_line {line expect_pattern {wait_pattern ""} {section ""}} {
    global output_file delay_ms
    if {$wait_pattern eq ""} {
        set wait_pattern $expect_pattern
    }
    if {$section ne ""} {
        log_section $section
    }
    wait_for_prompt $wait_pattern
    after $delay_ms
    send -- "$line\r"
    expect {
        -re "---- More \( Press 'Q' to break \) ----" {
            set buf $expect_out(buffer)
            while 1 {
                send " "
                expect {
                    -re "---- More \( Press 'Q' to break \) ----" {
                        append buf $expect_out(buffer)
                        exp_continue
                    }
                    -re "More \( Press 'Q' to break \)" {
                        append buf $expect_out(buffer)
                        exp_continue
                    }
                    -re $expect_pattern {
                        append buf $expect_out(buffer)
                        break
                    }
                    timeout { break }
                }
            }
        }
        -re $expect_pattern {
            set buf $expect_out(buffer)
        }
        timeout {
            set buf "TIMEOUT waiting '$line' (expected: $expect_pattern)\n"
            recover_prompt $wait_pattern
        }
    }
    set f [open $output_file a]
    puts -nonewline $f $buf
    close $f
    after $delay_ms
}

file delete -force $output_file
log_section "CONNECT - single SSH session"

spawn ssh {*}$ssh_opts root@10.11.104.2

expect {
    -re "(?i)password:" {
        send -- "admin\r"
    }
    -re "upper limit|Reenter times" {
        puts stderr "SSH LOCKED - wait before retry"
        exit 2
    }
    timeout {
        puts stderr "TIMEOUT at login"
        exit 1
    }
}

set p_user "MA5608T>"
set p_enable "MA5608T#"
set p_config "MA5608T\\(config\\)#"
set p_gpon "MA5608T\\(config-if-gpon-0/0\\)#"
set p_line "MA5608T\\(config-gpon-lineprofile-1\\)#"
set p_srv "MA5608T\\(config-gpon-srvprofile-1\\)#"

wait_for_prompt $p_user
enter_enable $p_user $p_enable
send_line "scroll 512" $p_enable $p_enable "INIT scroll enable"
send_line "screen-length 0 temporary" $p_enable $p_enable "INIT screen-length enable"

send_line "?" $p_enable $p_enable "ENABLE MODE (?)"
send_line "display ?" $p_enable $p_enable "ENABLE MODE (display ?)"
send_line "display ont ?" $p_enable $p_enable "ENABLE MODE (display ont ?)"
send_line "display ont info ?" $p_enable $p_enable "ENABLE MODE (display ont info ?)"
send_line "display ont autofind ?" $p_enable $p_enable "ENABLE MODE (display ont autofind ?)"
send_line "display ont optical-info ?" $p_enable $p_enable "ENABLE MODE (display ont optical-info ?)"
send_line "display ont-lineprofile ?" $p_enable $p_enable "ENABLE MODE (display ont-lineprofile ?)"
send_line "display ont-srvprofile ?" $p_enable $p_enable "ENABLE MODE (display ont-srvprofile ?)"
send_line "display ont-tr069-server-profile ?" $p_enable $p_enable "ENABLE MODE (display ont-tr069-server-profile ?)"
send_line "display service-port ?" $p_enable $p_enable "ENABLE MODE (display service-port ?)"
send_line "display dba-profile ?" $p_enable $p_enable "ENABLE MODE (display dba-profile ?)"
send_line "display traffic table ?" $p_enable $p_enable "ENABLE MODE (display traffic table ?)"
send_line "display snmp-agent ?" $p_enable $p_enable "ENABLE MODE (display snmp-agent ?)"
send_line "display current-configuration ?" $p_enable $p_enable "ENABLE MODE (display current-configuration ?)"
send_line "display board ?" $p_enable $p_enable "ENABLE MODE (display board ?)"
send_line "display port ?" $p_enable $p_enable "ENABLE MODE (display port ?)"
send_line "display vlan ?" $p_enable $p_enable "ENABLE MODE (display vlan ?)"

send_line "config" $p_config $p_enable "ENTER config"
send_line "screen-length 0 temporary" $p_config $p_config "INIT screen-length config"

send_line "?" $p_config $p_config "CONFIG MODE (?)"
send_line "display ?" $p_config $p_config "CONFIG MODE (display ?)"
send_line "interface ?" $p_config $p_config "CONFIG MODE (interface ?)"
send_line "ont ?" $p_config $p_config "CONFIG MODE (ont ?)"
send_line "ont-lineprofile ?" $p_config $p_config "CONFIG MODE (ont-lineprofile ?)"
send_line "ont-srvprofile ?" $p_config $p_config "CONFIG MODE (ont-srvprofile ?)"
send_line "ont-tr069-server-profile ?" $p_config $p_config "CONFIG MODE (ont-tr069-server-profile ?)"
send_line "dba-profile ?" $p_config $p_config "CONFIG MODE (dba-profile ?)"
send_line "traffic table ?" $p_config $p_config "CONFIG MODE (traffic table ?)"
send_line "service-port ?" $p_config $p_config "CONFIG MODE (service-port ?)"
send_line "vlan ?" $p_config $p_config "CONFIG MODE (vlan ?)"
send_line "acl ?" $p_config $p_config "CONFIG MODE (acl ?)"
send_line "snmp-agent ?" $p_config $p_config "CONFIG MODE (snmp-agent ?)"

send_line "interface gpon 0/0" $p_gpon $p_config "ENTER interface gpon 0/0"

send_line "?" $p_gpon $p_gpon "GPON 0/0 (?)"
send_line "display ?" $p_gpon $p_gpon "GPON 0/0 (display ?)"
send_line "ont ?" $p_gpon $p_gpon "GPON 0/0 (ont ?)"
send_line "ont add ?" $p_gpon $p_gpon "GPON 0/0 (ont add ?)"
send_line "ont confirm ?" $p_gpon $p_gpon "GPON 0/0 (ont confirm ?)"
send_line "ont delete ?" $p_gpon $p_gpon "GPON 0/0 (ont delete ?)"
send_line "ont reset ?" $p_gpon $p_gpon "GPON 0/0 (ont reset ?)"
send_line "ont port ?" $p_gpon $p_gpon "GPON 0/0 (ont port ?)"
send_line "ont ipconfig ?" $p_gpon $p_gpon "GPON 0/0 (ont ipconfig ?)"
send_line "ont tr069-server-config ?" $p_gpon $p_gpon "GPON 0/0 (ont tr069-server-config ?)"
send_line "ont wan-config ?" $p_gpon $p_gpon "GPON 0/0 (ont wan-config ?)"
send_line "port ?" $p_gpon $p_gpon "GPON 0/0 (port ?)"

send_line "quit" $p_config $p_gpon "EXIT gpon interface"

send_line "ont-lineprofile gpon profile-id 1" $p_line $p_config "ENTER line profile 1"
send_line "?" $p_line $p_line "LINE PROFILE (?)"
send_line "display ?" $p_line $p_line "LINE PROFILE (display ?)"
send_line "quit" $p_config $p_line "EXIT line profile"

send_line "ont-srvprofile gpon profile-id 1" $p_srv $p_config "ENTER srv profile 1"
send_line "?" $p_srv $p_srv "SRV PROFILE (?)"
send_line "display ?" $p_srv $p_srv "SRV PROFILE (display ?)"
send_line "quit" $p_config $p_srv "EXIT srv profile"

send_line "quit" $p_enable $p_config "EXIT config"
send_line "quit" $p_user $p_enable "LOGOUT enable"

expect {
    -re "\\(y/n\\)" {
        send -- "y\r"
        exp_continue
    }
    eof {}
}

puts "\nDONE single session -> $output_file"
