MONGO_ROOT_USER=genieacs
MONGO_ROOT_PASSWORD=CAMBIAR_openssl_rand_base64_24
GENIEACS_UI_JWT_SECRET=CAMBIAR_openssl_rand_hex_64
GENIEACS_MONGODB_CONNECTION_URL=mongodb://genieacs:CAMBIAR_openssl_rand_base64_24@mongo/genieacs?authSource=admin

CWMP_WORKER_PROCESSES=2
MAX_CONCURRENT_REQUESTS=25

# Backend → NBI (nombres en /opt/gigafiber/.env del Tomcat; no valores aquí)
# GENIEACS_ENABLED=false
# GENIEACS_NBI_BASE_URL=http://127.0.0.1:7557
# GENIEACS_WAIT_TIMEOUT_MS=90000
# GENIEACS_OFFLINE_WAIT_TIMEOUT_MS=15000
# GENIEACS_POLL_INTERVAL_MS=5000
# GENIEACS_TASK_TIMEOUT_MS=30000
# GENIEACS_CONNECT_TIMEOUT_MS=5000
# GENIEACS_DEFAULT_DNS=8.8.8.8,8.8.4.4
# GENIEACS_WAN_VLAN_ID=1
# GENIEACS_STAGING_WAN_INDEX=1
# GENIEACS_CLIENT_WAN_INDEX=2
# GENIEACS_CLIENT_WAN_NAME_PATTERN=2_INTERNET_R_VID_{vlan}

# GenieACS ext → ACS WAR (inform-notify). Same name in /opt/gigafiber/.env for Tomcat.
# GENIEACS_TO_ACS_NOTIFY_URL=http://tomcat-staging:8080/ispadmin-staging-acs
# GENIEACS_TO_ACS_API_KEY=dev-genieacs-to-acs-key
# Must match Tomcat runtime GENIEACS_TO_ACS_API_KEY (recreate containers after changing .env).
