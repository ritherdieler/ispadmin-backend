VPS_HOST=212.85.13.47
VPS_USER=root
VPS_PORT=22
DOCKER_COMPOSE_DIR=/opt/gigafiber
DOCKER_TOMCAT_CONTAINER=tomcat9027
DOCKER_TOMCAT_STAGING_CONTAINER=tomcat-staging
TOMCAT_STAGING_HTTP_PORT=8081
DOCKER_TOMCAT_LIB_HOST_DIR=/opt/gigafiber/tomcat/lib
DOCKER_FACE_MODELS_HOST_DIR=/opt/gigafiber/models
DOCKER_TOMCAT_DOCKERFILE=/opt/gigafiber/tomcat/Dockerfile
DOCKER_COMPOSE_FILE=/opt/gigafiber/docker-compose.yml
CATALINA_HOME=/usr/local/tomcat
WAR_NAME=ispadmin.war
SSH_IDENTITY_FILE=
DEPLOY_SSH_PASSWORD=

# Ruta del .env remoto donde se escribe APP_RELEASE (versionado por deploy)
BACKEND_ENV_FILE=/opt/gigafiber/.env

# Token Mapbox para routing server-side (Directions/Matrix). Mismo pk. del frontend.
# Se puede definir aqui o exportar MAPBOX_ACCESS_TOKEN al ejecutar deploy.sh
MAPBOX_ACCESS_TOKEN=

# Registro de deploys en el hub de observabilidad (POST /observability/releases).
# OBS_BASE_URL: URL base de la API (context-path /ispadmin incluido).
# OBS_API_KEY: key con header X-Obs-Api-Key (usar OBS_API_KEY_DASHBOARD del backend).
# Si se dejan vacíos, el deploy no falla: solo omite el registro.
OBS_BASE_URL=https://api.gigafiberperu.cloud/ispadmin
OBS_API_KEY=

# NetDiag NOC (env_file Tomcat /opt/gigafiber/.env). Generar NET_DIAG_API_KEY: openssl rand -hex 24
# NET_DIAG_ENABLED=true
# NET_DIAG_API_KEY=
# NET_DIAG_WHATSAPP_NOC_PHONE=519XXXXXXXX
# RouterOS REST desde Tomcat (obligatorio rest en prod; ver .agent-docs/router-os-rest-prod-fix.md)
# ROUTER_OS_CLIENT_ADAPTER=rest
# ROUTER_OS_REST_TRUSTSTORE_PASSWORD=
# OLT_GATEWAY_ENABLED=true
# OLT_GATEWAY_API_KEY=
# OLT_GATEWAY_PASSWORD=
# Staging Gateway hornea olt.gateway.writes.enabled=true. Prod: OLT_GATEWAY_WRITES_ENABLED (default false).
# URL interna horneada en el WAR, no aqui.
# TRAFFIC_API_KEY=
# OLT_GATEWAY_INTERNAL_BASE_URL and OLT_GATEWAY_DATASOURCE_URL are baked into the WAR
# (staging WARs inside tomcat-staging talk on :8080; host→staging is :8081).
# Do not put them in /opt/gigafiber/.env.
# ACS_API_KEY=   # openssl rand -hex 16; misma key Gateway ↔ ACS WAR y ahora también Core → ACS (X-Acs-Key)
# ACS_CLIENT_ENABLED=   # Core HTTP client hacia ACS WAR; staging lo hornea en true
# ACS_INTERNAL_BASE_URL=   # no en .env compartido; staging Core hornea http://127.0.0.1:8080/ispadmin-staging-acs
# PPPOE_MIGRATION_QUARANTINE_DAYS=7  # no es secreto; default 7
# OLT_GATEWAY_ACS_BASE_URL is baked (staging: http://127.0.0.1:8080/ispadmin-staging-acs)
# Staging deploy must keep embedded modules in Core and enable HTTP clients:
# --with observability,netdiag,servicehealth,oltgateway,traffic,acs

# SmartOLT cloud (solo si olt.provider.*=SMARTOLT en el WAR Gateway). No commitear el valor.
# OLT_SERVICE_BASE_URL=https://gigafiberperu.smartolt.com/api/
# OLT_SERVICE_API_KEY=
# OLT_PROVIDER_AUTHORIZE=GATEWAY
# OLT_PROVIDER_DELETE=GATEWAY
# OLT_PROVIDER_REBOOT=GATEWAY
# OLT_PROVIDER_MOVE=GATEWAY

# Redis interno (cache 360 + Streams). Staging: REDIS_ENABLED=true REDIS_HOST=redis
# REDIS_PASSWORD=   # openssl rand -hex 16; no commitear el valor
# REDIS_PORT=6379

# OLT Gateway SNMP (timeout/lock óptico; no commitear community). Defaults en el WAR.
# OLT_GATEWAY_SNMP_TIMEOUT_MS=
# OLT_GATEWAY_SNMP_RETRIES=
# OLT_GATEWAY_SNMP_MAX_REPETITIONS=
# OLT_GATEWAY_SNMP_REQUEST_INTERVAL_MS=
# OLT_GATEWAY_SNMP_OPTICAL_PARALLEL_COLUMNS=
# OLT_GATEWAY_SNMP_OPTICAL_PARALLEL_PORTS=
# OLT_GATEWAY_SNMP_OPTICAL_PER_PORT=
# OLT_GATEWAY_SNMP_FUSED_INVENTORY_OPTICAL=
# OLT_GATEWAY_SNMP_FUSED_SNAPSHOT_MAX_AGE_MS=
# OLT_GATEWAY_SNMP_INVENTORY_TIMEOUT_MS=
# OLT_GATEWAY_SNMP_INVENTORY_RETRIES=
# OLT_GATEWAY_SNMP_POLL_LOCK_ENABLED=
# OLT_GATEWAY_SNMP_POLL_LOCK_KEY=
# OLT_GATEWAY_SNMP_POLL_LOCK_TTL_MS=
# OLT_GATEWAY_SNMP_POLL_LOCK_SHARED=

# GenieACS TR-069: loguea cada POST NBI como curl en logs Tomcat (grep '[GenieACS curl]').

# GenieACS TR-069: loguea cada POST NBI como curl en logs Tomcat (grep '[GenieACS curl]').

# GenieACS TR-069: loguea cada POST NBI como curl en logs Tomcat (grep '[GenieACS curl]').
# Activar solo durante pruebas; incluye claves WiFi en texto plano.
# DEPLOY_GENIEACS_LOG_CURL=true ./scripts/deploy.sh --deploy
# DEPLOY_GENIEACS_LOG_CURL=

# Runtime variable forwarded through the deployment environment (no real value here):
# OLT_GATEWAY_OPERATION_SECRET=
