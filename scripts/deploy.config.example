VPS_HOST=212.85.13.47
VPS_USER=root
VPS_PORT=22
DOCKER_COMPOSE_DIR=/opt/gigafiber
DOCKER_TOMCAT_CONTAINER=tomcat9027
DOCKER_TOMCAT_LIB_HOST_DIR=/opt/gigafiber/tomcat/lib
DOCKER_TOMCAT_DOCKERFILE=/opt/gigafiber/tomcat/Dockerfile
DOCKER_COMPOSE_FILE=/opt/gigafiber/docker-compose.yml
CATALINA_HOME=/usr/local/tomcat
WAR_NAME=ispadmin.war
SSH_IDENTITY_FILE=
DEPLOY_SSH_PASSWORD=

# Ruta del .env remoto donde se escribe APP_RELEASE (versionado por deploy)
BACKEND_ENV_FILE=/opt/gigafiber/.env

# Token Mapbox para routing server-side (Directions/Matrix). Mismo pk. del frontend.
# Se puede definir aqui o exportar MAPBOX_ACCESS_TOKEN al ejecutar deploy.sh
MAPBOX_ACCESS_TOKEN=

# Registro de deploys en el hub de observabilidad (POST /observability/releases).
# OBS_BASE_URL: URL base de la API (context-path /ispadmin incluido).
# OBS_API_KEY: key con header X-Obs-Api-Key (usar OBS_API_KEY_DASHBOARD del backend).
# Si se dejan vacíos, el deploy no falla: solo omite el registro.
OBS_BASE_URL=https://api.gigafiberperu.cloud/ispadmin
OBS_API_KEY=

# NetDiag NOC (env_file Tomcat /opt/gigafiber/.env). Generar NET_DIAG_API_KEY: openssl rand -hex 24
# NET_DIAG_ENABLED=true
# NET_DIAG_API_KEY=
# NET_DIAG_WHATSAPP_NOC_PHONE=519XXXXXXXX
# RouterOS REST desde Tomcat (obligatorio rest en prod; ver .agent-docs/router-os-rest-prod-fix.md)
# ROUTER_OS_CLIENT_ADAPTER=rest
# ROUTER_OS_REST_TRUSTSTORE_PASSWORD=
# OLT_GATEWAY_ENABLED=true
# OLT_GATEWAY_API_KEY=
# OLT_GATEWAY_PASSWORD=
# CRM (solo VPS /opt/gigafiber/.env — no deploy.sh): CRM_SECRETS_MASTER_KEY, OPENAI_API_KEY bootstrap opcional
