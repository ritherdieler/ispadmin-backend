# env.prod.example — Plantilla de variables de entorno para producción
#
# INSTRUCCIONES:
#   1. Copiar este archivo al VPS como /opt/gigafiber/.env.prod
#   2. Completar cada valor con los datos reales de producción
#   3. NUNCA commitear el archivo .env.prod al repositorio
#   4. El docker-compose.yml del VPS debe referenciar este archivo:
#        env_file: /opt/gigafiber/.env.prod
#
# ROTACIÓN DE TOKENS:
#   - WHATSAPP_ACCESS_TOKEN: rotar en Meta for Developers > WhatsApp > Configuration
#   - WHATSAPP_APP_SECRET: rotar en Meta for Developers > App Settings > Basic
#   - Después de rotar, reiniciar el contenedor Tomcat: docker compose restart tomcat9027

# ── Spring Profile ────────────────────────────────────────────────────────────
# Activar perfil de producción; no cambiar en producción
SPRING_PROFILES_ACTIVE=prod

# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
# Obtener desde: Meta for Developers > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=COMPLETAR_TOKEN_PRODUCTIVO

# Obtener desde: Meta for Developers > WhatsApp > API Setup > Phone number ID
WHATSAPP_PHONE_NUMBER_ID=COMPLETAR_PHONE_NUMBER_ID

# Obtener desde: Meta for Developers > WhatsApp > API Setup > WhatsApp Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=COMPLETAR_WABA_ID

# ── Webhook WhatsApp ──────────────────────────────────────────────────────────
# Token que nosotros elegimos; debe coincidir exactamente con el configurado en
# Meta for Developers > WhatsApp > Configuration > Webhook > Verify Token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=COMPLETAR_TOKEN_SECRETO_WEBHOOK

# App Secret para validar firma X-Hub-Signature-256 en el POST del webhook
# Obtener desde: Meta for Developers > App Settings > Basic > App Secret (click Show)
WHATSAPP_APP_SECRET=COMPLETAR_APP_SECRET

# ── CRM LLM / OpenAI (Fase 4) ─────────────────────────────────────────────────
# Clave maestra AES para cifrar secretos en BD (p.ej. openssl rand -hex 32).
# Obligatoria en produccion para rotar el token OpenAI desde el backoffice.
CRM_SECRETS_MASTER_KEY=COMPLETAR_CLAVE_MAESTRA_AES
# Opcional: bootstrap inicial si la BD aun no tiene token (la UI tiene prioridad).
OPENAI_API_KEY=
CRM_OPENAI_MODEL=gpt-4o-mini

# ── Observabilidad — API keys por plataforma (header X-Obs-Api-Key) ────────────
# Generar valores aleatorios distintos por plataforma (p.ej. openssl rand -hex 24).
# La app/backoffice/asistencias/android envían su key en cada request de ingesta;
# el dashboard usa OBS_API_KEY_DASHBOARD para consultar.
OBS_API_KEY_BACKOFFICE=COMPLETAR_KEY_BACKOFFICE
OBS_API_KEY_ASISTENCIAS=COMPLETAR_KEY_ASISTENCIAS
OBS_API_KEY_ANDROID=COMPLETAR_KEY_ANDROID
OBS_API_KEY_DASHBOARD=COMPLETAR_KEY_DASHBOARD

# ── Observabilidad — Sesion de lectura/gestion del dashboard (token HMAC ADMIN) ─
# Secreto para firmar/verificar el token de sesion emitido en el login ADMIN.
# Generar un valor aleatorio (p.ej. openssl rand -hex 32). Si falta, el login no
# emite token y las lecturas de /observability responden 401.
OBS_SESSION_SECRET=COMPLETAR_SECRETO_SESION

# TTL del access token (minutos) y del refresh token (minutos). El access se usa en
# cada request (Authorization: Bearer); el refresh renueva el access sin re-login.
OBS_SESSION_TTL_MIN=720
OBS_SESSION_REFRESH_TTL_MIN=43200

# Directorio de replays de sesión (debe existir y ser escribible por el contenedor)
OBS_REPLAY_DIR=/var/lib/wispadmin/observability/replays

# ── Observabilidad — Simbolicación (source maps / ProGuard-R8) ─────────────────
# Activa la simbolicación lazy y los endpoints de subida de artefactos
OBS_SYMBOLS_ENABLED=true
# Directorio de artefactos de símbolos (debe existir y ser escribible por el contenedor)
OBS_SYMBOLS_DIR=/var/lib/wispadmin/observability/symbols
# Tamaño máximo por artefacto subido (bytes)
OBS_SYMBOLS_MAX_BYTES=60000000
# Retención de artefactos de símbolos (días)
OBS_SYMBOLS_RETENTION_DAYS=120

# URL base del dashboard para deep-links en tickets y notificaciones de alertas
# (ej: https://observability.gigafiberperu.cloud)
OBS_DASHBOARD_BASE_URL=https://observability.gigafiberperu.cloud

# ── Observabilidad — Motor de alertas ─────────────────────────────────────────
# enabled: activa el evaluador programado y el handler de issues nuevos/regresión
OBS_ALERTS_ENABLED=true
# Intervalo del evaluador de reglas de métrica (ms)
OBS_ALERTS_INTERVAL_MS=60000
# Ventana de deduplicación para no repetir la misma alerta (minutos)
OBS_ALERTS_DEDUP_MIN=15

# ── Observabilidad — Métricas de infraestructura/JVM + pool de BD ──────────────
# enabled: activa el muestreo periódico de métricas JVM/sistema/HikariCP
OBS_SYSTEM_ENABLED=true
# Intervalo de muestreo (ms)
OBS_SYSTEM_INTERVAL_MS=15000
# Publicar cada muestra en vivo por WebSocket (type OBS_SYSTEM_METRIC)
OBS_SYSTEM_PUBLISH_LIVE=true
# Retención de la serie temporal de métricas de sistema (días)
OBS_SYSTEM_RETENTION_DAYS=7

# ── Observabilidad — Integración issue tracker (opcional) ──────────────────────
# Proveedor: jira | webhook | none
OBS_TRACKER_PROVIDER=jira
# Secreto para validar el webhook entrante de sincronización de estado (si aplica)
OBS_TRACKER_WEBHOOK_SECRET=
# Jira (dejar OBS_JIRA_ENABLED=false si no se usa)
OBS_JIRA_ENABLED=false
OBS_JIRA_BASE_URL=
OBS_JIRA_EMAIL=
OBS_JIRA_API_TOKEN=
OBS_JIRA_PROJECT_KEY=
OBS_JIRA_ISSUE_TYPE=Bug
