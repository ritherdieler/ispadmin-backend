#!/usr/bin/expect -f
set timeout 30
set olt_pass [lindex $argv 0]
set ssh_host [lindex $argv 1]
set ssh_port [lindex $argv 2]
set ssh_user [lindex $argv 3]

if {$olt_pass eq ""} {
    puts "Usage: olt-tftp-save-cfg.expect <olt_password> \[ssh_host\] \[ssh_port\] \[ssh_user\]"
    exit 1
}
if {$ssh_host eq ""} { set ssh_host "10.11.104.2" }
if {$ssh_port eq ""} { set ssh_port "22" }
if {$ssh_user eq ""} { set ssh_user "oltadmin" }

log_user 1

spawn ssh -p $ssh_port \
    -o ServerAliveInterval=5 \
    -o ServerAliveCountMax=240 \
    -o TCPKeepAlive=yes \
    -o KexAlgorithms=+diffie-hellman-group-exchange-sha1,diffie-hellman-group1-sha1 \
    -o HostKeyAlgorithms=+ssh-rsa \
    -o PubkeyAcceptedAlgorithms=+ssh-rsa \
    -o Ciphers=aes128-cbc \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    ${ssh_user}@${ssh_host}
expect -re {[Pp]assword:}
send -- "$olt_pass\r"
expect "MA5608T>"
send -- "enable\r"
expect "MA5608T#"
send -- "save configuration\r"
expect {
    -re "please wait|MA5608T#" {}
    timeout {}
}
puts "SAVE_CFG_TRIGGERED"
set timeout 5
set loops 0
while {$loops < 48} {
    incr loops
    expect {
        -re "Configuration file had been saved successfully|saved successfully" {
            puts "SAVE_CFG_DONE"
            catch {send -- "quit\r"}
            exit 0
        }
        eof {
            puts "SAVE_CFG_TRIGGERED_DISCONNECTED"
            exit 0
        }
        timeout {}
    }
}
puts "SAVE_CFG_TRIGGERED_TIMEOUT"
catch {send -- "quit\r"}
exit 0
