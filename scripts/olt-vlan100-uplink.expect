#!/usr/bin/env expect -f
set timeout 120
set apply 0
if {[llength $argv] > 0 && [lindex $argv 0] eq "apply"} {
    set apply 1
}

set ssh_opts "-o StrictHostKeyChecking=no -o PreferredAuthentications=password -o PubkeyAuthentication=no -o KexAlgorithms=diffie-hellman-group-exchange-sha1 -o HostKeyAlgorithms=ssh-rsa -o PubkeyAcceptedKeyTypes=ssh-rsa -o Ciphers=aes128-cbc -o ConnectionAttempts=1"
set log_file "/tmp/olt-vlan100-uplink.log"
file delete -force $log_file

proc log_line {msg} {
    global log_file
    set f [open $log_file a]
    puts $f $msg
    close $f
    puts $msg
}

proc wait_prompt {} {
    expect {
        -re "---- More \\( Press 'Q' to break \\) ----" {
            send " "
            exp_continue
        }
        -re "More \\( Press 'Q' to break \\)" {
            send " "
            exp_continue
        }
        -re "MA5608T\\(config-if-mcu-0/3\\)#" {
            return
        }
        -re "MA5608T\\(config\\)#" {
            return
        }
        -re "MA5608T#" {
            return
        }
        -re "MA5608T>" {
            return
        }
        -re "\\(y/n\\)" {
            send -- "y\r"
            exp_continue
        }
        timeout {
            log_line "TIMEOUT waiting prompt"
            return
        }
    }
}

proc send_cmd {line} {
    log_line ">>> $line"
    send -- "$line\r"
    wait_prompt
}

spawn ssh {*}$ssh_opts oltadmin@10.11.104.2
expect {
    -re "(?i)password:" { send -- "GigaOlt2026\r" }
    timeout { log_line "LOGIN TIMEOUT"; exit 1 }
}
wait_prompt

send_cmd "enable"
send_cmd "config"
send_cmd "mmi-mode enable"
send_cmd "quit"

send_cmd "display vlan 100"
send_cmd "display current-configuration section vlan-config"
send_cmd "display port desc 0/3"

if {$apply} {
    log_line "=== APPLY VLAN 100 uplink 0/3/2 (MK2) ==="
    send_cmd "config"
    send_cmd "vlan 100 smart"
    send_cmd "port vlan 100 0/3 2"
    send_cmd "interface mcu 0/3"
    send_cmd "native-vlan 2 vlan 100"
    send_cmd "quit"
    send_cmd "undo port vlan 1 0/3 2"
    send_cmd "quit"
    send_cmd "display vlan 100"
    send_cmd "display current-configuration section vlan-config"
    send_cmd "save configuration"
    send_cmd "quit"
}

send_cmd "quit"
expect {
    eof { }
    timeout { }
}
log_line "DONE apply=$apply log=$log_file"
