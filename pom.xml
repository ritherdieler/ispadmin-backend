        <profile>
            <id>prod-war</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>bake-spring-profile</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <replaceregexp file="${project.build.outputDirectory}/application.properties"
                                                       match="^spring\.profiles\.active=.*"
                                                       replace="spring.profiles.active=prod"
                                                       byline="true"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>staging-war</id>
            <properties>
                <warName>ispadmin-staging</warName>
                <subsystem.excludes>WEB-INF/classes/com/dscorp/wispadmin/observability/**,WEB-INF/classes/com/dscorp/wispadmin/oltgateway/**,WEB-INF/classes/com/dscorp/wispadmin/netdiag/**,WEB-INF/classes/com/dscorp/wispadmin/traffic/**,WEB-INF/classes/com/dscorp/wispadmin/servicehealth/**,WEB-INF/classes/com/dscorp/wispadmin/acs/**</subsystem.excludes>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>bake-spring-profile</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <replaceregexp file="${project.build.outputDirectory}/application.properties"
                                                       match="^spring\.profiles\.active=.*"
                                                       replace="spring.profiles.active=prod,staging,subsystem"
                                                       byline="true"/>
                                        <replaceregexp file="${project.build.outputDirectory}/application.properties"
                                                       match="^server\.servlet\.context-path=.*"
                                                       replace="server.servlet.context-path=/ispadmin-staging"
                                                       byline="true"/>
                                        <mkdir dir="${project.build.directory}"/>
                                        <exec executable="bash" failonerror="true">
                                            <arg value="${project.basedir}/scripts/subsystems.sh"/>
                                            <arg value="--with"/>
                                            <arg value="${subsystem.with}"/>
                                            <arg value="--write-dir"/>
                                            <arg value="${project.build.directory}"/>
                                            <arg value="--props-dir"/>
                                            <arg value="${project.build.outputDirectory}"/>
                                        </exec>
                                        <copy file="${project.build.directory}/subsystem-enabled.properties"
                                              tofile="${project.build.outputDirectory}/application-subsystem.properties"
                                              overwrite="true"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
